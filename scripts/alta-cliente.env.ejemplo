# Alta de una peluqueria nueva. Se copia, se rellena y se le pasa al script:
#
#   cp scripts/alta-cliente.env.ejemplo /tmp/peluqueria-tal.env
#   $EDITOR /tmp/peluqueria-tal.env
#   ./scripts/alta-cliente.sh /tmp/peluqueria-tal.env
#
# NO se guarda dentro del repo: lleva la contrasena del primer administrador y la cadena
# de conexion a la base de datos del cliente.

# --- Donde esta la instalacion recien levantada ---------------------------------------
# El backend de ESE cliente, ya desplegado y con las migraciones pasadas.
API="https://peluqueria-tal.onrender.com"

# La base de datos de ESE cliente. Solo se usa para una cosa: ascender a ADMIN la primera
# cuenta. No hay endpoint que lo haga, y no debe haberlo.
# Formato: postgresql://usuario:password@host:puerto/basededatos?sslmode=require
DB="postgresql://postgres.xxxx:PASSWORD@aws-0-eu-west-3.pooler.supabase.com:5432/postgres?sslmode=require"

# --- La primera cuenta ----------------------------------------------------------------
# La del dueno de la peluqueria. Se crea por el endpoint de registro, o sea con la
# contrasena cifrada por la propia aplicacion: aqui no se inventa ningun hash.
ADMIN_NOMBRE="Nombre Apellido"
ADMIN_EMAIL="duena@peluqueriatal.es"
ADMIN_PASSWORD="CambiaEstoYa1!"
ADMIN_TELEFONO="600000000"

# --- Los datos del negocio ------------------------------------------------------------
NEGOCIO_NOMBRE="Peluqueria Tal"
NEGOCIO_ESLOGAN=""
NEGOCIO_TELEFONO="+34 900 000 000"
NEGOCIO_EMAIL="hola@peluqueriatal.es"
NEGOCIO_DIRECCION="Calle de Ejemplo, 1"
NEGOCIO_LOCALIDAD="46000 Valencia, Espana"
NEGOCIO_LOGO_URL=""
NEGOCIO_COLOR=""

# Horario fijo de cada semana. Los festivos y cierres puntuales NO van aqui: se ponen
# desde el panel, en «Dias cerrados».
NEGOCIO_APERTURA="09:00"
NEGOCIO_CIERRE="20:00"
# Dias en los que no se abre nunca, separados por comas. Vacio = se abre todos los dias.
# Nombres en ingles: MONDAY, TUESDAY, WEDNESDAY, THURSDAY, FRIDAY, SATURDAY, SUNDAY.
NEGOCIO_DIAS_CERRADOS="SUNDAY"

# --- Con que modulos arranca ----------------------------------------------------------
# SOLO_AGENDA    citas y recordatorios; sin cobros, sin escaparate y sin nomina
# AGENDA_Y_CAJA  lo anterior mas cobro en efectivo o transferencia y produccion
# TODO           el producto entero, pasarela de tarjeta incluida
#
# Ni SOLO_AGENDA ni AGENDA_Y_CAJA encienden el pago con tarjeta, y no es un descuido:
# Stripe necesita una cuenta y unas claves propias de este negocio. Hasta que las tenga,
# encenderlo seria ofrecerle al cliente final una pasarela que devuelve error.
PERFIL="AGENDA_Y_CAJA"

# --- Servicios de ejemplo (opcional) --------------------------------------------------
# "true" crea tres servicios para que el catalogo no nazca vacio y se pueda probar a
# agendar el mismo dia. Se borran o se editan despues desde el panel.
SERVICIOS_DE_EJEMPLO="true"
